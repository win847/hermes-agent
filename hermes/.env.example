# Custom LLM Provider
CUSTOM_LLM_API_KEY=your_api_key_here
CUSTOM_LLM_BASE_URL=https://your-api-host.com/v1

# QQBot Configuration
QQ_APP_ID=your_qq_app_id
QQ_CLIENT_SECRET=your_qq_client_secret

# Default Model
DEFAULT_MODEL=custom/glm-5-1

# Allow all users (set to true for testing)
GATEWAY_ALLOW_ALL_USERS=true
